# 复制成 .env 再改（.env 已 gitignore，**不会**进版本库）
#
#   copy .env.example .env
#
# 至少要把下面两个 ★ 改成你自己的值再启动。

# ─────────────────────────────────────────────────────────────
# ★ 必填：JWT 签名密钥
#
# 不设的话后端会用内置的开发默认值，后果是：
#   - 重启容器 → 所有已登录用户被踢下线（密钥变了，旧 token 全部验不过）
#   - 多实例部署 → 实例之间互相踢
# 生成一个随机值（PowerShell）：
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# ─────────────────────────────────────────────────────────────
KB_JWT_SECRET=

# ─────────────────────────────────────────────────────────────
# ★ 必填（首次部署）：初始管理员密码，至少 8 位
#
# ⚠ 只在**账号不存在**时用来创建；账号已存在**不会**被重置
#   （避免"容器一重启密码就变回去"）。要主动重置：改这里的值再重启。
# ⚠ 首次登录后建议在后台右上角改成自己的密码，然后把这里清空。
# ─────────────────────────────────────────────────────────────
KB_ADMIN_PASSWORD=
KB_ADMIN_EMPLOYEE_NO=A001
KB_ADMIN_NAME=科室管理员

# ─────────────────────────────────────────────────────────────
# 访问端口：内网其它客户端用 http://<本机IP>:<这个端口>
# ─────────────────────────────────────────────────────────────
ADMIN_PORT=8080

# ─────────────────────────────────────────────────────────────
# 镜像仓库（轩辕镜像）
#
# 打包/推送时用；目标机器上 `docker compose up -d` 会去这里拉。
# 登录（密码不要写进本文件）：
#   docker login docker.xuanyuan.run
# ─────────────────────────────────────────────────────────────
IMAGE_PREFIX=docker.xuanyuan.run/kf-record
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────
# 可选：SQLite 并发参数（一般不用改）
# ─────────────────────────────────────────────────────────────
# KB_SQLITE_BUSY_TIMEOUT_MS=5000
# KB_SQLITE_WAL=true

# ─────────────────────────────────────────────────────────────
# 可选：Cookie 属性。同源部署（默认）保持 lax + false。
# 若上 HTTPS 且前后端**分域名**，必须改成 none + true。
# ─────────────────────────────────────────────────────────────
# KB_REFRESH_COOKIE_SAMESITE=lax
# KB_REFRESH_COOKIE_SECURE=false
