        {
          "key": "home_frequency",
          "type": "single",
          "label": "1.1 居家训练频次",
          "options": [
            "每日2次，每次20min",
            "每日1次，每次20min"
          ]
        },
        {
          "key": "diet_manage",
          "type": "multi",
          "label": "2.饮食管理",
          "options": [
            "循序渐进过渡饮食",
            "细嚼慢咽",
            "短期内忌坚硬、过烫食物"
          ]
        },
        {
          "key": "safety_tip",
          "type": "multi",
          "label": "3.安全提示",
          "options": [
            "进食保持端坐体位",
            "出现反复呛咳及时就诊"
          ]
        },
        {
          "key": "follow_up",
          "type": "single",
          "label": "4.复诊建议",
          "options": [
            "1个月后康复科门诊复查吞咽功能",
