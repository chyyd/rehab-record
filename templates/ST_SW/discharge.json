{
  "version": 1,
  "discipline": "ST_SW",
  "kind": "discharge",
  "title": "康复出院小结（吞咽）",
  "trigger": {
    "mandatory": true
  },
  "soap": [
    {
      "key": "s",
      "label": "S",
      "heading": "主观资料",
      "fields": [
        {
          "key": "summary",
          "type": "text",
          "label": "治疗过程汇总",
          "auto": "latest_vs_initial",
          "hint": "自动生成，只读：共治疗 N 次、首评→最近复评的吞咽功能变化"
        },
        {
          "key": "subjective_change",
          "type": "multi",
          "label": "出院时患者情况",
          "options": [
            "糊状半流质进食无呛咳",
            "温水吞咽基本安全",
            "无咽喉异物感",
            "进食后无痰多胸闷"
          ]
        },
        {
          "key": "family_note",
          "type": "multi",
          "label": "家属",
          "options": [
            "掌握居家进食护理要点"
          ]
        }
      ]
    },
    {
      "key": "o",
      "label": "O",
      "heading": "客观资料",
      "fields": [
        {
          "key": "oral_motor",
          "type": "single",
          "label": "唇舌软腭运动",
          "options": [
            "基本正常",
            "轻度异常",
            "中度异常"
          ]
        },
        {
          "key": "swallow_reflex",
          "type": "single",
          "label": "吞咽反射",
          "options": [
            "灵敏",
            "延迟",
            "消失"
          ],
          "prefill": "last_assessment"
        },
        {
          "key": "kubota",
          "type": "single",
          "label": "洼田饮水试验",
          "options": [
            "1级（优）",
            "2级（良）",
            "3级（中）",
            "4级（可）",
            "5级（差）"
          ],
          "prefill": "last_assessment",
          "hint": "洼田饮水试验：让患者端坐位一次咽下 30ml 温水。1级=一次顺利咽下无呛咳；2级=分2次以上咽下无呛咳；3级=一次咽下但有呛咳；4级=分2次以上咽下且有呛咳；5级=屡屡呛咳且不能全部咽下。等级越高障碍越重。"
        },
        {
          "key": "kubota_result",
          "type": "single",
          "label": "洼田结果判断",
          "options": [
            "正常（1级且5秒内完成）",
            "可疑（1级超5秒，或2级）",
            "异常（3–5级，提示吞咽障碍）"
          ]
        },
        {
          "key": "oral_intake",
          "type": "single",
          "label": "经口进食情况",
          "options": [
            "可完全经口进食",
            "部分经口+部分鼻饲",
            "仍需鼻饲"
          ]
        },
        {
          "key": "tube",
          "type": "single",
          "label": "胃管",
          "options": [
            "已拔除胃管",
            "保留胃管"
          ]
        },
        {
          "key": "residue",
          "type": "single",
          "label": "食物残留",
          "options": [
            "无残留",
            "少量残留"
          ]
        },
        {
          "key": "aspiration_risk",
          "type": "single",
          "label": "误吸风险",
          "options": [
            "低风险",
            "中风险",
            "高风险"
          ],
          "prefill": "last_assessment"
        }
      ]
    },
    {
      "key": "a",
      "label": "A",
      "heading": "评估分析",
      "fields": [
        {
          "key": "goal_achieved",
          "type": "single",
          "label": "住院吞咽康复目标",
          "options": [
