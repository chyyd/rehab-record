            "部分达成",
            "未达成"
          ]
        },
        {
          "key": "risk_change",
          "type": "single",
          "label": "误吸风险",
          "options": [
            "降至低风险",
            "维持中风险",
            "仍为高风险"
          ]
        },
        {
          "key": "residual",
          "type": "multi",
          "label": "远期注意",
          "options": [
